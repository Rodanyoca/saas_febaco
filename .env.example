# Obligatoires : accès Google et classeur utilisateurs FEBACO.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_USERS_ID=

# Obligatoire : au moins 32 caractères. AUTH_SECRET est prioritaire.
AUTH_SECRET=
# Facultatif : alias historique si AUTH_SECRET est absent.
AUTH_SESSION_SECRET=
# Obligatoire : au moins 32 caractères, indépendant du secret de session.
AUTH_TELEMETRY_HMAC_KEY=

# Obligatoires pour les blocs métier utilisés et les contrôles territoriaux.
GOOGLE_SHEETS_STRUCTURE_ID=
GOOGLE_SHEETS_ACTEURS_ID=
GOOGLE_SHEETS_AFFILIATIONS_ID=
GOOGLE_SHEETS_REFERENTIEL_ID=
GOOGLE_SHEETS_LICENCES_ID=
GOOGLE_SHEETS_COMPETITIONS_ID=
GOOGLE_SHEETS_EQUIPE_NATIONALE_ID=
GOOGLE_SHEETS_ACTIVITES_ID=
GOOGLE_SHEETS_DOCUMENTS_ID=

# Facultatifs : surcharger les valeurs par défaut des lectures métier.
# Laisser ces variables non définies pour conserver les valeurs par défaut.
# GOOGLE_REFERENTIAL_CACHE_TTL_MS=
# GOOGLE_OPERATIONAL_CACHE_TTL_MS=
# GOOGLE_REQUEST_TIMEOUT_MS=
# GOOGLE_MAX_RETRIES=
# GOOGLE_READ_CONCURRENCY=
# GOOGLE_WRITE_CONCURRENCY=
# GOOGLE_RETRY_BASE_DELAY_MS=
# GOOGLE_RETRY_MAX_DELAY_MS=
# GOOGLE_REQUEST_LOG_LEVEL=

# Migration uniquement : clé AES indépendante, exactement 64 caractères hexadécimaux.
# Obligatoire pour apply/reset/revoke/disable/purge/restore ; inutile pour plan.
AUTH_MIGRATION_BACKUP_KEY=

# Facultatifs pour les médias : requis seulement pour les fonctions concernées.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_CLUB_LOGO_FOLDER_ID=
